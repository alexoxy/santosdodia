{
  "name": "santosdodia",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run repo:audit && npm run publication:boundary-test && npm run automation:audit && npm run automation:test && npm run dropbox:archive-test && npm run cloudflare:guardrails-audit && npm run cloudflare:guardrails-test && npm run osint:registry-audit && npm run osint:normalize-test && npm run data:audit && npm run claims:audit && npm run leaders:audit && npm run calendar:audit && npm run calendar:reference-test && npm run calendar:normalize-test && npm run calendar:approval-test && npm run calendar:staging-test && npm run db:migrations-test && npm run db:sql-parser-test && npm run db:d1-local-test && npm run db:d1-remote-safety-test && npm run api:validate && npm run typecheck && npm run lint && npm run build",
    "cloudflare:build": "opennextjs-cloudflare build",
    "cloudflare:preview": "opennextjs-cloudflare preview",
    "cloudflare:deploy": "opennextjs-cloudflare deploy",
    "cloudflare:upload": "opennextjs-cloudflare upload",
    "cloudflare:guardrails-audit": "node scripts/cloudflare-free-guardrails.mjs audit",
    "cloudflare:guardrails-test": "node scripts/test-cloudflare-free-guardrails.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "api:validate": "node scripts/validate-api-contracts.mjs",
    "automation:audit": "node scripts/audit-automation-registry.mjs",
    "automation:test": "node scripts/test-automation-registry.mjs",
    "calendar:approval-test": "node scripts/test-calendar-staging-approval.mjs",
    "calendar:audit": "node scripts/audit-calendar-engine-policy.mjs",
    "calendar:normalize": "node scripts/normalize-calendar-staging-package.mjs",
    "calendar:normalize-test": "node scripts/test-normalized-calendar-package.mjs",
    "calendar:reference-test": "node scripts/test-calendar-reference-vectors.mjs",
    "calendar:sql": "node scripts/build-calendar-staging-sql.mjs",
    "calendar:staging-test": "node scripts/test-calendar-staging-sql.mjs",
    "claims:audit": "node scripts/audit-claim-evidence.mjs",
    "data:audit": "node scripts/with-runtime-snapshot.mjs scripts/audit-data-quality.mjs",
    "data:report": "node scripts/with-runtime-snapshot.mjs scripts/audit-data-quality.mjs --markdown docs/data-quality-baseline.md",
    "data:sync": "node scripts/sync-observances.mjs",
    "db:d1-local-test": "node scripts/test-d1-local.mjs",
    "db:d1-remote-safety-test": "node scripts/test-d1-staging-api.mjs",
    "db:migrations-test": "node scripts/test-database-migrations.mjs",
    "db:sql-parser-test": "node scripts/test-sql-statement-list.mjs",
    "dropbox:archive-test": "node scripts/test-dropbox-archive.mjs",
    "leaders:audit": "node scripts/audit-ecclesiastical-directory.mjs",
    "leaders:sync": "node scripts/sync-ecclesiastical-directory.mjs",
    "leaders:sql": "node scripts/build-ecclesiastical-staging-sql.mjs",
    "leaders:approved-sql": "node scripts/build-portugal-leaders-seed.mjs",
    "osint:monitor": "node scripts/monitor-ecclesiastical-osint.mjs",
    "osint:registry-audit": "node scripts/osint/audit-registry.mjs",
    "osint:robots-audit": "node scripts/osint/audit-robots.mjs",
    "osint:dump": "node scripts/osint/run-manifest.mjs",
    "osint:normalize": "node scripts/osint/normalize-wikidata-saints.mjs",
    "osint:normalize-test": "node scripts/osint/test-normalize-wikidata-saints.mjs",
    "repo:audit": "node scripts/audit-repository-hygiene.mjs",
    "sources:freshness": "node scripts/audit-source-freshness.mjs",
    "publication:boundary-test": "node scripts/test-publication-boundaries.mjs",
    "litcal:sync": "node scripts/sync-litcal-mirror.mjs",
    "litcal:source": "bash scripts/mirror-litcal-source.sh",
    "translations:sync": "node scripts/with-runtime-snapshot.mjs scripts/sync-name-translations.mjs",
    "translations:validate": "node scripts/validate-language-quality.mjs",
    "translations:grammar": "node scripts/audit-languagetool.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "next": "15.5.21",
    "react": "19.1.7",
    "react-dom": "19.1.7"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "eslint": "^9.11.1",
    "eslint-config-next": "15.5.21",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "2.1.4"
    },
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    },
    "miniflare": {
      "undici": "7.29.0"
    }
  }
