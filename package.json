{
  "name": "santosdodia",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "cloudflare:build": "opennextjs-cloudflare build",
    "cloudflare:preview": "opennextjs-cloudflare preview",
    "cloudflare:deploy": "opennextjs-cloudflare deploy",
    "cloudflare:upload": "opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "data:sync": "node scripts/sync-observances.mjs",
    "osint:monitor": "node scripts/monitor-ecclesiastical-osint.mjs",
    "litcal:sync": "node scripts/sync-litcal-mirror.mjs",
    "litcal:source": "bash scripts/mirror-litcal-source.sh",
    "translations:sync": "node scripts/sync-name-translations.mjs",
    "translations:validate": "node scripts/validate-language-quality.mjs",
    "translations:grammar": "node scripts/audit-languagetool.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@vercel/analytics": "^1.5.0",
    "next": "15.5.21",
    "react": "19.1.7",
    "react-dom": "19.1.7"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "eslint": "^9.11.1",
    "eslint-config-next": "15.5.21",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.18"
    }
  }
}
