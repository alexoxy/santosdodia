{
  "schemaVersion": 1,
  "targetMode": "fully-autonomous",
  "phase": "shadow",
  "principles": {
    "requestTimeExternalAcquisition": false,
    "productionMustRemainAvailableOnAgentFailure": true,
    "lastKnownGoodWinsOnUncertainty": true,
    "everyMutationRequiresProvenance": true,
    "everyProductionPromotionRequiresRollback": true,
    "dropboxIsTheImmutableBoundaryBetweenAgents": true,
    "noAgentMaySkipAStage": true
  },
  "agents": [
    {
      "id": "scout",
      "role": "discover sources, assess authority/access/licence, acquire approved evidence and archive immutable raw packages in Dropbox",
      "reads": ["public-web", "source-registry", "policy-registry"],
      "writes": ["dropbox:raw", "dropbox:source-candidates", "dropbox:receipts"],
      "productionWrite": false
    },
    {
      "id": "normalizer",
      "role": "consume verified Dropbox raw packages, extract facts, deduplicate, resolve identities, cross-check assertions, preserve conflicts and archive normalized packages",
      "reads": ["dropbox:raw"],
      "writes": ["dropbox:normalized", "dropbox:conflicts", "dropbox:validation"],
      "internetAccess": false,
      "productionWrite": false
    },
    {
      "id": "importer",
      "role": "consume verified normalized packages, apply idempotent D1 staging imports, verify counts and invariants, retain rollback bookmarks and later promote only when gates permit",
      "reads": ["dropbox:normalized"],
      "writes": ["cloudflare-d1:staging", "dropbox:import-receipts"],
      "internetAccess": false,
      "productionWrite": false
    }
  ],
  "acquisition": {
    "maxSourcesPerCycle": 4,
    "requiredPolicyDecision": "approved",
    "requireSourceSpecificAdapter": true,
    "failClosedOnSourceError": true,
    "archiveBeforeDownstreamUse": true
  },
  "normalization": {
    "requireVerifiedDropboxIndex": true,
    "requireRawSha256Match": true,
    "requireUpstreamRunLineage": true,
    "preserveConflictingAssertions": true,
    "neverFetchSourceAtNormalizationTime": true
  },
  "import": {
    "target": "cloudflare-d1-staging",
    "requireVerifiedDropboxIndex": true,
    "requireNormalizedSha256Match": true,
    "requireIdempotencyKey": true,
    "requirePreImportBookmark": true,
    "requirePostImportVerification": true,
    "automaticRollbackOnFailure": true
  },
  "promotion": {
    "automaticProductionWrites": false,
    "minimumConfidence": 0.92,
    "minimumIndependentSources": 2,
    "allowSingleAuthoritativeSource": true,
    "authoritativeClasses": ["A1", "A2"],
    "maximumOpenHighSeverityConflicts": 0,
    "requireStableCanonicalIdentity": true,
    "requireCompleteProvenance": true,
    "requireBaselineComparison": true,
    "requireRollbackPackage": true,
    "requirePostPromotionHealthCheck": true
  },
  "sourcePipelines": {
    "wikidata": {
      "lane": "saints",
      "normalizer": "scripts/osint/normalize-wikidata-saints.mjs",
      "publicationClass": "discovery-and-enrichment",
      "canAutoPromoteAlone": false
    }
  },
  "runtime": {
    "orchestration": "github-actions",
    "archive": "dropbox",
    "canonicalDatabase": "cloudflare-d1",
    "futureDurablePromotionAndRollback": "cloudflare-workflows"
  }
}
