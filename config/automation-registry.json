{
  "schemaVersion": 1,
  "timezone": "UTC",
  "policy": {
    "automaticProductionWrites": false,
    "requestTimeExternalAcquisition": false,
    "editorialTextRequiresHumanApproval": true,
    "sourceFailuresAreReviewCandidatesOnly": true
  },
  "tasks": [
    {
      "id": "production-health",
      "title": "Cloudflare production health",
      "owner": "platform",
      "mode": "scheduled",
      "workflow": ".github/workflows/production-health.yml",
      "crons": ["17 * * * *"],
      "publicationMode": "read-only",
      "archiveStream": null,
      "producerScripts": []
    },
    {
      "id": "observance-refresh",
      "title": "Weekly observance staging",
      "owner": "data-operations",
      "mode": "scheduled",
      "workflow": ".github/workflows/update-observances.yml",
      "crons": ["15 4 * * 1"],
      "publicationMode": "staging-only",
      "archiveStream": "observances",
      "producerScripts": [
        "scripts/sync-observances.mjs",
        "scripts/build-runtime-fallback.mjs"
      ]
    },
    {
      "id": "litcal-refresh",
      "title": "Weekly LitCal staging",
      "owner": "data-operations",
      "mode": "scheduled",
      "workflow": ".github/workflows/update-litcal-mirror.yml",
      "crons": ["35 3 * * 2"],
      "publicationMode": "staging-only",
      "archiveStream": "litcal",
      "producerScripts": [
        "scripts/mirror-litcal-source.sh",
        "scripts/sync-litcal-mirror.mjs",
        "scripts/sync-name-translations.mjs"
      ]
    },
    {
      "id": "ecclesiastical-osint",
      "title": "Weekly official ecclesiastical change monitor",
      "owner": "data-operations",
      "mode": "scheduled",
      "workflow": ".github/workflows/osint-monitor.yml",
      "crons": ["17 05 * * 1"],
      "publicationMode": "staging-only",
      "archiveStream": "ecclesiastical-osint",
      "producerScripts": ["scripts/monitor-ecclesiastical-osint.mjs"]
    },
    {
      "id": "source-freshness",
      "title": "Weekly source freshness report",
      "owner": "data-operations",
      "mode": "scheduled",
      "workflow": ".github/workflows/source-freshness.yml",
      "crons": ["29 8 * * 0"],
      "publicationMode": "staging-only",
      "archiveStream": "source-freshness",
      "producerScripts": ["scripts/audit-source-freshness.mjs"]
    },
    {
      "id": "autonomous-data-plane-shadow",
      "title": "Autonomous acquisition and normalization shadow cycle",
      "owner": "data-operations",
      "mode": "scheduled",
      "workflow": ".github/workflows/autonomous-data-plane-shadow.yml",
      "crons": ["47 2 * * 3"],
      "publicationMode": "staging-only",
      "archiveStream": "autonomous-data-plane",
      "producerScripts": ["scripts/autonomy/run-shadow-data-plane.mjs"]
    },
    {
      "id": "quality-gate",
      "title": "Repository and Cloudflare quality gate",
      "owner": "platform",
      "mode": "event-driven",
      "workflow": ".github/workflows/quality.yml",
      "crons": [],
      "publicationMode": "none",
      "archiveStream": null,
      "producerScripts": []
    },
    {
      "id": "cloudflare-portability",
      "title": "Cloudflare portability build",
      "owner": "platform",
      "mode": "event-driven",
      "workflow": ".github/workflows/cloudflare-portability.yml",
      "crons": [],
      "publicationMode": "none",
      "archiveStream": null,
      "producerScripts": []
    },
    {
      "id": "d1-staging-control",
      "title": "Approved D1 staging operations",
      "owner": "data-operations",
      "mode": "manual",
      "workflow": ".github/workflows/d1-staging.yml",
      "crons": [],
      "publicationMode": "staging-only",
      "archiveStream": null,
      "producerScripts": ["scripts/manage-d1-staging.mjs"]
    },
    {
      "id": "ecclesiastical-directory-staging",
      "title": "Bounded ecclesiastical directory staging",
      "owner": "data-operations",
      "mode": "manual",
      "workflow": ".github/workflows/sync-ecclesiastical-directory.yml",
      "crons": [],
      "publicationMode": "staging-only",
      "archiveStream": "ecclesiastical-directory/{source}",
      "producerScripts": [
        "scripts/sync-ecclesiastical-directory.mjs",
        "scripts/build-ecclesiastical-staging-sql.mjs"
      ]
    },
    {
      "id": "wikidata-normalization",
      "title": "Immutable Wikidata normalization",
      "owner": "data-operations",
      "mode": "manual",
      "workflow": ".github/workflows/osint-wikidata-normalization-phase2.yml",
      "crons": [],
      "publicationMode": "staging-only",
      "archiveStream": "wikidata-normalized",
      "producerScripts": ["scripts/osint/normalize-wikidata-saints.mjs"]
    }
  ]
}
