{
  "schemaVersion": 1,
  "principle": "partitioned-three-stage-pipeline-with-transversal-gates",
  "dataStages": ["scout", "normalizer", "importer"],
  "transversalGates": ["language-editor"],
  "globalRules": {
    "noGlobalQueue": true,
    "noGlobalLock": true,
    "sourceFailureIsolation": true,
    "lastKnownGoodOnFailure": true,
    "immutableDropboxBoundaryBetweenStages": true,
    "idempotencyRequired": true,
    "checksumsRequired": true,
    "deadLetterRequired": true,
    "boundedRetries": 3,
    "productionWritesDuringShadow": false
  },
  "lanes": [
    {
      "id": "saints",
      "domains": ["saints", "persons", "names", "identifiers", "dates", "patronages", "places", "recognition-events"],
      "partitionKey": "source_id",
      "rawStreamTemplate": "osint-raw/saints/{source_id}",
      "normalizedStreamTemplate": "osint-normalized/saints/{source_id}",
      "reviewedStreamTemplate": "osint-reviewed/saints/{source_id}",
      "importTarget": "d1:knowledge-graph",
      "maxConcurrentPartitions": 4,
      "priority": "P0"
    },
    {
      "id": "calendars",
      "domains": ["calendar", "observances", "feasts", "date-rules", "lectionary"],
      "partitionKey": "church_or_jurisdiction",
      "rawStreamTemplate": "osint-raw/calendars/{partition}",
      "normalizedStreamTemplate": "osint-normalized/calendars/{partition}",
      "reviewedStreamTemplate": "osint-reviewed/calendars/{partition}",
      "importTarget": "d1:calendar",
      "maxConcurrentPartitions": 6,
      "priority": "P0"
    },
    {
      "id": "hierarchy",
      "domains": ["churches", "jurisdictions", "leaders", "appointments", "succession"],
      "partitionKey": "source_id_or_church",
      "rawStreamTemplate": "osint-raw/hierarchy/{partition}",
      "normalizedStreamTemplate": "osint-normalized/hierarchy/{partition}",
      "reviewedStreamTemplate": "osint-reviewed/hierarchy/{partition}",
      "importTarget": "d1:knowledge-graph",
      "maxConcurrentPartitions": 6,
      "priority": "P0"
    },
    {
      "id": "media",
      "domains": ["official-media", "live-streams", "archives", "channels"],
      "partitionKey": "institution_id",
      "rawStreamTemplate": "osint-raw/media/{partition}",
      "normalizedStreamTemplate": "osint-normalized/media/{partition}",
      "reviewedStreamTemplate": "osint-reviewed/media/{partition}",
      "importTarget": "d1:knowledge-graph",
      "maxConcurrentPartitions": 8,
      "priority": "P1"
    },
    {
      "id": "documents",
      "domains": ["documents", "decrees", "liturgical-law", "recognition-events"],
      "partitionKey": "publisher_id",
      "rawStreamTemplate": "osint-raw/documents/{partition}",
      "normalizedStreamTemplate": "osint-normalized/documents/{partition}",
      "reviewedStreamTemplate": "osint-reviewed/documents/{partition}",
      "importTarget": "d1:knowledge-graph",
      "maxConcurrentPartitions": 4,
      "priority": "P1"
    }
  ],
  "handoffContract": {
    "scoutToNormalizer": {
      "store": "dropbox",
      "required": ["verified_index", "raw_package", "source_receipts", "sha256", "source_run_id"]
    },
    "normalizerToLanguageEditor": {
      "store": "dropbox",
      "required": ["verified_index", "normalized_package", "quality_report", "conflict_report", "upstream_lineage", "sha256"]
    },
    "languageEditorToImporter": {
      "store": "dropbox",
      "required": ["verified_index", "reviewed_package", "linguistic_review", "upstream_lineage", "sha256"]
    },
    "importerToProduction": {
      "store": "cloudflare-d1",
      "required": ["idempotency_key", "pre_import_bookmark", "post_import_verification", "rollback_receipt"]
    }
  }
}
