{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.santosdodia.com/schemas/source-registry.schema.json",
  "title": "SantosDia global OSINT source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "generatedAt", "status", "scoreScale", "sources"],
  "properties": {
    "registryVersion": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "minLength": 1},
    "scoreScale": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "url",
        "traditions",
        "languages",
        "domains",
        "access",
        "authorityClass",
        "authorityScore",
        "priority"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "name": {"type": "string", "minLength": 2},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "traditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "jurisdictions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "access": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authorityClass": {"type": "string", "pattern": "^[A-D][0-9]?$"},
        "authorityScore": {"type": "integer", "minimum": 0, "maximum": 100},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "notes": {"type": "string"}
      }
    }
  }
}
