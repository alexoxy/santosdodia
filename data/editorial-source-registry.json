    "chronology": ["interactive-century-timeline", "era-navigation", "historical-context-introductions", "filters-by-tradition", "filters-by-geography", "filters-by-status", "filters-by-vocation", "links-back-to-liturgical-day"],
    "saintPage": ["identity", "why-remembered", "life", "chronology", "patronage", "symbols", "places", "prayers", "novenas", "related-saints", "other-traditions", "sources"]
  }
