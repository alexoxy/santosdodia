      "traditions": ["Roman Catholic"],
      "coverage": ["chronological navigation", "century groupings", "saint life spans", "historical context by century", "calendar-alphabetical-chronological navigation pattern"],
      "allowedUses": ["chronology-product-pattern-learning", "candidate-era-generation", "candidate-life-span-generation", "historical-context-topic-discovery"],
      "forbiddenUses": ["sole-date-authority", "canonical-status-authority", "verbatim-historical-narrative-republication"],
