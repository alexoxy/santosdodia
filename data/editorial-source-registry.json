  "devotionalContentModel": {
    "prayer": {
      "required": ["tradition", "locale", "sourceUrl", "prayerType", "rightsStatus"],
      "prayerTypes": ["official-liturgical", "traditional", "approved-devotional", "contemporary-devotional", "unknown"],
      "rightsStatuses": ["public-domain", "licensed", "permission-confirmed", "link-only", "unknown"]
    },
    "novena": {
      "required": ["title", "tradition", "sourceUrl", "associatedEntityType", "associatedEntityId", "scheduleBasis", "rightsStatus"],
      "scheduleBasis": ["fixed-feast-minus-nine-days", "movable-feast-relative", "source-defined", "unscheduled"],
      "publicationRule": "Association and schedule require authoritative feast/date corroboration before surfacing as a calendar reminder."
    }
  },
  "chronologyContentModel": {
    "dateTypes": ["birth", "death", "martyrdom", "major-life-event", "canonization", "beatification", "feast-establishment", "observance-date", "traditional-date"],
    "precision": ["exact-day", "month-year", "year", "year-range", "century", "circa", "traditional", "symbolic", "unknown"],
    "requiredForTimelineEntry": ["entityId", "eventType", "dateOrRange", "precision", "tradition", "sourceUrl", "sourceClass"],
    "rules": [
      "A saint page may contain several independent chronological events.",
      "Death or martyrdom normally anchors a person's historical position when known, but must not be substituted for the liturgical observance date.",
      "Feasts and Marian or Christological observances may be timeline events without being person births or deaths.",
      "Approximate, traditional and symbolic dates must remain visibly qualified.",
      "Calendar-system conversion must preserve original calendar semantics and source jurisdiction."
    ]
  },
  "productImplications": {
    "today": ["saints-and-observances", "prayer-or-devotion-when-validated", "novena-starting-today"],
